{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "systematics-bm",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "systematics-black-midi-db",
      "database_id": "cb486eb8-32f7-40f2-9a2b-d50968e12a90"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "systematics-black-midi-files"
    }
  ]
}
